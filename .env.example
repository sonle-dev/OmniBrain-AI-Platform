# ════════════════════════════════════════════════════════════════════
#  OmniBrain AI Platform — Master Hybrid Engine
#  Environment Configuration Template
#  Copy this file to .env and fill in your keys.
# ════════════════════════════════════════════════════════════════════

# ── 1. OmniBrain Client Authentication ──────────────────────────────
# Format: key:app_id:token_budget:rpm   (comma-separate multiple keys)
OMNIBRAIN_API_KEYS="demo_key:demo_app:1000000:60"

# ── 2. Redis (Optional — falls back to in-memory LRU cache) ─────────
OMNIBRAIN_REDIS_URL=""
# OMNIBRAIN_REDIS_URL="redis://localhost:6379/0"

# ── 3. Ollama (Local Models) ─────────────────────────────────────────
OLLAMA_BASE_URL="http://localhost:11434"
# Required models (install with 'ollama pull <model>'):
#   ollama pull qwen2.5:7b          (chat — excellent Vietnamese)
#   ollama pull deepseek-r1:8b      (reasoning, quiz generation)
#   ollama pull nomic-embed-text    (embeddings for GraphRAG)
#   ollama pull llama3.2-vision     (vision / OCR — optional, needs GPU)

# ── 4. Cloud AI Keys (ALL OPTIONAL) ─────────────────────────────────
# System boots cleanly with all keys empty.
# Only models with valid keys are added to the fallback chain.

# Google Gemini (Free tier: https://aistudio.google.com/)
GEMINI_API_KEY=""

# OpenRouter (Free Gemma/Llama models: https://openrouter.ai/)
OPENROUTER_API_KEY=""

# OpenAI
OPENAI_API_KEY=""

# DeepSeek (Cheapest reasoning: https://platform.deepseek.com/)
DEEPSEEK_API_KEY=""

# Anthropic Claude
ANTHROPIC_API_KEY=""

# ── 5. External Search ───────────────────────────────────────────────
# Tavily (1,000 free searches/mo: https://tavily.com/)
TAVILY_API_KEY=""

# ── 6. Semantic Cache ────────────────────────────────────────────────
SEMANTIC_CACHE_ENABLED=True
SEMANTIC_CACHE_MAX_MEMORY=128
