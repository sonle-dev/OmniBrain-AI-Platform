# OMNIBRAIN AI CORE CONFIGURATION

# Allowed API keys configuration
# Format: OMNIBRAIN_API_KEYS="api_key:app_id:token_budget:rpm" (Multiple keys separated by commas)
OMNIBRAIN_API_KEYS="demo_key:demo_app:1000000:60,lms_secret_key:lms_app:5000000:120"

# Redis Server URL (Optional: falls back to SQLite semantic cache if not specified)
OMNIBRAIN_REDIS_URL=redis://127.0.0.1:6379

# External Knowledge Search API Keys
TAVILY_API_KEY="tvly-your-tavily-api-key-here"

# Multi-LLM Unified Gateway Credentials (LiteLLM)
# Configure keys based on the models you want to use:
GEMINI_API_KEY="AIzaSyYourGeminiKeyHere"
OPENAI_API_KEY="sk-proj-YourOpenAIKeyHere"
DEEPSEEK_API_KEY="sk-YourDeepseekKeyHere"
ANTHROPIC_API_KEY="sk-ant-YourAnthropicKeyHere"

# Default Model configuration (LiteLLM identifier)
# e.g., gemini/gemini-2.0-flash, openai/gpt-4o-mini, deepseek/deepseek-chat
OMNIBRAIN_DEFAULT_MODEL="gemini/gemini-2.0-flash"

# Semantic cache control
SEMANTIC_CACHE_THRESHOLD=0.90
SEMANTIC_CACHE_ENABLED=True
